{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        ".read": "$code.matches(/^[A-Z0-9]{5}$/)",
        ".write": "$code.matches(/^[A-Z0-9]{5}$/) && (data.exists() || newData.child('t').isNumber())"
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "firstKill": {
      "abyssking": {
        ".read": true,
        "1": {
          ".write": "auth != null && !data.exists() && newData.exists()",
          ".validate": "newData.hasChildren(['uid', 'name', 't']) && newData.child('uid').val() === auth.uid && newData.child('name').isString() && newData.child('name').val().length <= 16 && newData.child('t').val() === now",
          "uid": {
            ".validate": true
          },
          "name": {
            ".validate": true
          },
          "t": {
            ".validate": true
          },
          "$other": {
            ".validate": false
          }
        },
